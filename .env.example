# Flask Configuration
DEBUG=True
HOST=0.0.0.0
PORT=5000

# MinerU Configuration
MINERU_TOKEN=your_mineru_token_here
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_LANGUAGE=id
MINERU_ENABLE_TABLE=True
MINERU_ENABLE_FORMULA=True
MINERU_IS_OCR=True

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Sumopod Configuration
SUMOPOD_API_KEY=sk-your_sumopod_api_key_here
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=gpt-4o-mini

# Legacy Azure OpenAI Configuration (commented out, kept for reference)
# AZURE_OPENAI_KEY=your_azure_openai_key_here
# AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
# AZURE_OPENAI_DEPLOYMENT=classroom-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# Azure Embedding Configuration
AZURE_EMBEDDING_URL=https://splace.openai.azure.com/openai/deployments/text-embedding-3-large/embeddings?api-version=2023-05-15
AZURE_EMBEDDING_API_KEY=your_azure_embedding_api_key_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vectors
DB_USER=postgres
DB_PASSWORD=123123
DB_SSLMODE=require

# Text Processing Configuration
MAX_TOKENS=1500
TOKENIZER_MODEL=bert-base-uncased

# Annotation Configuration
MAX_CHARS_PER_PAGE=500

# Output Directory Configuration
EXTRACTED_TEXTS_DIR=extracted_texts
